{
	"name": "sitegloss",
	"version": "0.3.1",
	"private": true,
	"description": "Mark what is wrong on a web page, open the marks in another environment to fix it, and talk them through with your AI app",
	"type": "module",
	"license": "MIT",
	"author": "Jean-Pierre Bergamin <james@ractive.ch>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ractive/sitegloss.git"
	},
	"scripts": {
		"build": "bun scripts/build.ts",
		"zip": "bun scripts/build.ts --zip",
		"icons": "bun scripts/icons.ts",
		"verify": "biome ci . && bun run typecheck && bun run test",
		"typecheck": "bun check -p tsconfig.json && bun check -p tsconfig.test.json",
		"lint": "biome check .",
		"fix": "biome check --write .",
		"test": "bun test --timeout 30000"
	},
	"dependencies": {
		"@ractive-ch/tab-mcp-client": "0.19.0-rc.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.7",
		"@modelcontextprotocol/client": "2.4.0",
		"@ractive-ch/tab-mcp": "0.13.0-rc.1",
		"@types/bun": "1.4.4",
		"@types/chrome": "0.3.7",
		"ajv": "8.20.0",
		"happy-dom": "21.0.4",
		"openapi-typescript": "7.13.0",
		"typescript": "7.0.2",
		"typescript-5": "npm:typescript@5.9.3"
	}
}
